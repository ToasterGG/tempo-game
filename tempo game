<!DOCTYPE html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Tempo</title>
<style>
:root{--bg:#0a0a18;--tx:#eef;--ac:#4ff;--pk:#f4a;--gd:#fc3;color-scheme:dark;box-sizing:border-box}
html,body{height:100%;margin:0;background:var(--bg);color:var(--tx);font:600 15px system-ui,sans-serif;overflow:hidden;-webkit-user-select:none;user-select:none;touch-action:manipulation}
#c{position:fixed;inset:0;width:100%;height:100%;touch-action:none}
.scr{position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;gap:8px;padding:calc(env(safe-area-inset-top,0px) + 10px) 12px calc(env(safe-area-inset-bottom,0px) + 10px)}
.hide{display:none}
h1{margin:0;font-size:36px;letter-spacing:8px;background:linear-gradient(90deg,var(--ac),var(--pk));-webkit-background-clip:text;background-clip:text;color:transparent}
#sum{text-align:center;max-width:420px;font-size:13px;opacity:.85;min-height:34px}
#tabs{display:flex;gap:8px}
#tree{flex:1;overflow:auto;width:100%;max-width:440px;display:flex;gap:6px;justify-content:center;align-items:flex-start;padding:4px 0}
.col{flex:1;display:flex;flex-direction:column;align-items:center}
.col.h{flex-direction:row;gap:6px;width:100%}
.col b{font-size:12px;opacity:.75;margin-bottom:4px}
.n{width:100%;max-width:96px;box-sizing:border-box;border:2px solid #345;border-radius:14px;background:#14142b;text-align:center;padding:6px 2px;font-size:11px}
.n i{font-style:normal;font-size:24px;display:block}
.n.can{border-color:var(--ac);box-shadow:0 0 10px #4ff6}
.n.own{border-color:var(--gd)}
.n.lock{opacity:.35}
.n.sel{outline:2px solid #fff}
.ln{width:3px;height:14px;background:#345}.ln.on{background:var(--ac)}
.card{background:#14142b;border-radius:14px;padding:10px;font-size:13px;text-align:center;width:100%;box-sizing:border-box;display:flex;flex-direction:column;gap:8px;align-items:center}
button{font:inherit;color:inherit;border:0;border-radius:14px;padding:10px 16px;background:#252548}
button.on{background:#3a3a78}
button:disabled{opacity:.4}
#det{width:100%;max-width:440px;min-height:64px;background:#14142b;border-radius:14px;padding:10px 12px;box-sizing:border-box;display:flex;gap:10px;align-items:center;justify-content:space-between;font-size:13px}
#play{width:100%;max-width:440px;font-size:22px;font-weight:800;padding:14px;background:linear-gradient(90deg,#0bb,#d2a)}
</style></head><body>
<canvas id="c"></canvas>
<div id="hub" class="scr"><h1>TEMPO</h1><div id="cur"></div><div id="sum"></div>
<div id="tabs"><button>Skills</button><button>Ascend</button></div>
<div id="tree"></div><div id="det"></div><button id="play">▶ PLAY</button></div>
<script>
const $=s=>document.querySelector(s),c=$('#c'),x=c.getContext('2d');
let W,H,dpr,G=null,F,lt=0,tab=0,sel='slow',cf=0,A;
let S={sh:0,co:0,cy:0,asc:0,bs:0,bl:0,lv:{},last:''};
try{Object.assign(S,JSON.parse(localStorage.getItem('tempo1')||'{}'))}catch(e){}
const sv=()=>{try{localStorage.setItem('tempo1',JSON.stringify(S))}catch(e){}};
const f=n=>n>=1e6?(n/1e6).toFixed(2)+'M':n>=1e4?(n/1e3).toFixed(1)+'k':Math.floor(n);
const L=id=>S.lv[id]||0,NM={T:'⏱ Time',P:'⚡ Power',S:'🛡 Safety',A:'🎯 Skill'};
const N=[
['slow','T','Slow Burn','🐢',10,20,1.55,l=>`Difficulty ramps ${Math.round((1-.92**l)*100)}% slower`],
['cryo','T','Cryo Orbs','❄️',8,45,1.6,l=>l?`${(1.2+.8*l).toFixed(1)}% of orbs freeze time`:'Off'],
['warp','T','Deep Freeze','🧊',6,120,1.7,l=>`Freeze lasts +${l}s, time runs at ${Math.round((.4-.04*l)*100)}%`],
['gain','P','Shard Rush','💎',20,25,1.5,l=>`+${l*25}% shards per run`],
['combo','P','Combo Fuel','🔥',10,60,1.6,l=>`${(.5+.1*l).toFixed(1)}x bonus per 10 combo`],
['midas','P','Midas Touch','👑',10,150,1.65,l=>`${(3+1.2*l).toFixed(1)}% gold orbs (x5 points)`],
['life','S','Extra Life','❤️',4,40,2.2,l=>`${3+l} lives`],
['wind','S','Second Wind','🩹',5,100,1.8,l=>l?`Heal 1 life every ${40-5*l} combo`:'Off'],
['defuse','S','Defuse','🛡️',5,220,1.9,l=>`${l*15}% chance a tapped bomb is safe`],
['wide','A','Fat Fingers','👆',6,30,1.6,l=>`Tap radius +${l*12}%`],
['auto','A','Autopop','🤖',8,90,1.6,l=>`${l*6}% of missed orbs pop themselves`],
['start','A','Head Start','🚀',6,250,1.9,l=>`Start at level ${1+l*2}`],
['cpow','C','Core Power','⚡',999,1,1.6,l=>`+${l*30}% shards`],
['ccalm','C','Core Calm','🌙',999,1,1.7,l=>`${Math.round((1-.96**l)*100)}% slower ramp`],
['cgold','C','Core Fortune','🍀',999,1,1.7,l=>`+${l*2}% gold orbs`]];
function fx(){const l=L;return{ramp:.92**l('slow')*.96**l('ccalm'),cp:l('cryo')?.012+.008*l('cryo'):0,fz:.4-.04*l('warp'),ft:3+l('warp')+l('cryo')*.3,gold:.03+.012*l('midas')+.02*l('cgold'),cm:.5+.1*l('combo'),def:.15*l('defuse'),wind:l('wind')?40-5*l('wind'):0,auto:.06*l('auto'),R:54*(1+.12*l('wide')),sm:(1+.25*l('gain'))*(1+.2*S.co)*(1+.3*l('cpow'))}}
function snd(fr,d=.07){try{if(!A)return;const o=A.createOscillator(),g=A.createGain();o.frequency.value=fr;g.gain.value=.05;g.gain.exponentialRampToValueAtTime(.001,A.currentTime+d);o.connect(g);g.connect(A.destination);o.start();o.stop(A.currentTime+d)}catch(e){}}
function aud(){try{A=A||new(window.AudioContext||window.webkitAudioContext)()}catch(e){}}
function play(){aud();F=fx();cf=0;const m=3+L('life');G={d:L('start')*20,t:0,score:0,combo:0,lives:m,m,o:[],sp:.5,fr:0,la:-1,lvl:1+L('start')*2,p:[],pops:0,sk:0,end:0};hub(0);lt=performance.now();requestAnimationFrame(tick)}
function tick(n){if(!G)return;const dt=Math.min(.05,(n-lt)/1e3);lt=n;up(dt);if(G){draw();requestAnimationFrame(tick)}}
function spawn(){let l;do l=Math.random()*5|0;while(l==G.la);G.la=l;const b=G.lvl>=3?Math.min(.22,.05+.01*G.lvl):0,r=Math.random();G.o.push({x:W*(l+.5)/5,y:-30,k:r<b?'b':r<b+F.gold?'g':r<b+F.gold+F.cp?'c':'n'})}
function up(dt){
if(G.end>0){G.end-=dt;if(G.end<=0){fin();return}}
else{G.t+=dt;G.d+=dt*F.ramp;G.lvl=Math.max(G.lvl,1+(G.d/10|0));
const sl=G.fr>0?F.fz:1;G.fr=Math.max(0,G.fr-dt);
const v=H*(.13+.016*G.d+.0003*G.d*G.d)*sl;
G.sp-=dt*sl;if(G.sp<=0){G.sp=Math.max(.17,1.05/(1+G.d*.045));spawn()}
for(const o of G.o){o.y+=v*dt;if(!o.dead&&o.y>H-60){o.dead=1;if(o.k!='b'){if(Math.random()<F.auto)pop(o);else miss()}}}
G.o=G.o.filter(o=>!o.dead)}
G.sk=Math.max(0,G.sk-dt);
for(const q of G.p){q.x+=q.vx*dt;q.y+=q.vy*dt;q.l-=dt}
G.p=G.p.filter(q=>q.l>0)}
function bur(o,col,n){for(let i=0;i<n;i++)G.p.push({x:o.x,y:o.y,vx:Math.random()*400-200,vy:Math.random()*400-200,l:.5,c:col})}
function fl(o,s,col){G.p.push({x:o.x,y:o.y-20,vx:0,vy:-70,l:.8,c:col,s})}
function chk(){if(G.lives<=0&&!G.end)G.end=.7}
function hurt(){G.sk=.25;try{navigator.vibrate(60)}catch(e){}snd(110,.25)}
function miss(){G.lives--;G.combo=0;hurt();chk()}
function pop(o){o.dead=1;const col={b:'#f44',g:'#fc3',c:'#7bf',n:'#4ff'}[o.k];
if(o.k=='b'){if(Math.random()<F.def){bur(o,'#8f8',8);fl(o,'DEFUSED','#8f8');return}G.lives--;G.combo=0;hurt();bur(o,col,18);chk();return}
G.combo++;G.pops++;snd(260+Math.min(G.combo,40)*16);
const p=Math.round(10*G.lvl*(1+(G.combo/10|0)*F.cm)*(o.k=='g'?5:1));G.score+=p;
if(o.k=='c')G.fr=F.ft;
if(F.wind&&G.combo%F.wind==0&&G.lives<G.m){G.lives++;fl(o,'+❤','#f6a')}
bur(o,col,10);fl(o,'+'+p,col)}
c.onpointerdown=e=>{if(!G||G.end>0)return;aud();let b,bd=F.R;for(const o of G.o){if(o.dead)continue;const d=Math.hypot(o.x-e.clientX,o.y-e.clientY);if(d<bd){bd=d;b=o}}if(b)pop(b)};
function fin(){const g=Math.floor(G.score/25*F.sm),nb=G.score>(S.bs||0);S.sh+=g;S.cy+=g;if(nb)S.bs=G.score;S.bl=Math.max(S.bl||0,G.lvl);S.last=`LVL ${G.lvl} · ${G.pops} pops · ${G.score} pts → +${f(g)} 💎${nb?' · NEW BEST!':''}`;G=null;sv();hub(1);rt()}
function draw(){x.setTransform(dpr,0,0,dpr,0,0);x.fillStyle=`hsl(${240+S.asc*40} 50% ${G.fr>0?16:7}%)`;x.fillRect(0,0,W,H);
if(G.sk>0)x.translate((Math.random()-.5)*12,(Math.random()-.5)*12);
const hu=(180+G.lvl*25)%360,hc=`hsl(${hu} 100% 60%)`;
x.strokeStyle=hc;x.lineWidth=3;x.globalAlpha=.5;x.beginPath();x.moveTo(0,H-60);x.lineTo(W,H-60);x.stroke();x.globalAlpha=1;
x.textAlign='center';x.textBaseline='middle';x.font='22px system-ui';
for(const o of G.o){const col=o.k=='b'?'#f33':o.k=='g'?'#fc3':o.k=='c'?'#7bf':hc;x.shadowBlur=18;x.shadowColor=col;x.fillStyle=o.k=='b'?'#200':col;x.strokeStyle=col;x.lineWidth=3;x.beginPath();x.arc(o.x,o.y,24,0,7);x.fill();x.stroke();x.shadowBlur=0;if(o.k!='n'){x.fillStyle='#fff';x.fillText(o.k=='b'?'✕':o.k=='g'?'★':'❄',o.x,o.y+1)}}
for(const q of G.p){x.globalAlpha=Math.min(1,q.l*2);x.fillStyle=q.c;if(q.s){x.font='bold 18px system-ui';x.fillText(q.s,q.x,q.y)}else x.fillRect(q.x,q.y,5,5)}
x.globalAlpha=1;x.fillStyle=hc;x.fillRect(0,0,W*((G.d%10)/10),4);
x.fillStyle='#fff';x.font='20px system-ui';x.textAlign='left';x.fillText('❤️'.repeat(Math.max(0,G.lives)),12,46);
x.textAlign='right';x.font='bold 22px system-ui';x.fillText('LVL '+G.lvl,W-12,46);
x.textAlign='center';x.font='bold 36px system-ui';x.fillText(G.score,W/2,92);
if(G.combo>1){x.font='bold 16px system-ui';x.fillStyle=hc;x.fillText(`${G.combo} COMBO · x${(1+(G.combo/10|0)*F.cm).toFixed(1)}`,W/2,124)}
if(G.fr>0){x.fillStyle='#7bf';x.font='bold 16px system-ui';x.fillText(`❄ ${G.fr.toFixed(1)}s`,W/2,148)}
if(G.t<4&&!G.end){x.globalAlpha=Math.min(1,4-G.t);x.fillStyle='#fff';x.font='bold 18px system-ui';x.fillText('TAP THE ORBS · AVOID ✕',W/2,H/2)}x.globalAlpha=1}
function hub(on){$('#hub').classList.toggle('hide',!on)}
function asc(){const g=Math.floor(Math.sqrt(S.cy/800));if(g<1)return;if(!cf){cf=1;rt();return}S.co+=g;S.asc++;S.sh=0;S.cy=0;for(const k in S.lv)if(N.find(n=>n[0]==k)[1]!='C')delete S.lv[k];cf=0;S.last=`Ascended! +${g} ✦ cores. Skills reset, but you’re stronger.`;sv();rt()}
function rt(){
$('#hub').style.background=`radial-gradient(circle at 50% 0,hsl(${240+S.asc*40} 60% 20%),#0a0a18 70%)`;
$('#cur').textContent=`💎 ${f(S.sh)} · ✦ ${S.co} cores · ★ LVL ${S.bl||0}${S.asc?' · ASC '+S.asc:''}`;
$('#sum').textContent=S.last||'Tap orbs before they hit the line. Never tap ✕. It only gets faster.';
document.querySelectorAll('#tabs button').forEach((b,i)=>b.className=i==tab?'on':'');
const T=$('#tree');T.innerHTML='';T.style.flexDirection=tab?'column':'row';
if(tab){const g=Math.floor(Math.sqrt(S.cy/800)),d=document.createElement('div');d.className='card';d.innerHTML=`<div>Ascend to reset skills and 💎 for <b>+${g} ✦ cores</b>.<br>Each core gives +20% shards forever. Spend cores on perks below.</div>`;const b=document.createElement('button');b.textContent=g<1?'Earn more 💎 to ascend':cf?'Tap again to confirm':'Ascend';b.disabled=g<1;b.onclick=asc;d.append(b);T.append(d)}
(tab?['C']:['T','P','S','A']).forEach(k=>{const col=document.createElement('div');col.className='col'+(tab?' h':'');if(!tab)col.innerHTML=`<b>${NM[k]}</b>`;
N.filter(n=>n[1]==k).forEach((n,i,a)=>{const id=n[0],l=L(id),cur=k=='C'?S.co:S.sh,cost=Math.ceil(n[5]*n[6]**l),ok=k=='C'||!i||L(a[i-1][0])>0;
if(i&&!tab){const ln=document.createElement('div');ln.className='ln'+(ok?' on':'');col.append(ln)}
const e=document.createElement('div');e.className='n'+(!ok?' lock':l>=n[4]?' own':cur>=cost?' can':'')+(sel==id?' sel':'');
e.innerHTML=`<i>${n[3]}</i>${n[2]}<br>${l}${n[4]<999?'/'+n[4]:''}`;e.onclick=()=>{sel=id;rt()};col.append(e)});T.append(col)});
const n=N.find(m=>m[0]==sel),k=n[1],br=N.filter(m=>m[1]==k),i=br.indexOf(n),l=L(sel),cur=k=='C'?S.co:S.sh,cost=Math.ceil(n[5]*n[6]**l),ok=k=='C'||!i||L(br[i-1][0])>0,mx=l>=n[4];
$('#det').innerHTML=`<div><b>${n[3]} ${n[2]}</b><br>${n[7](l)}${mx?' · MAX':' → '+n[7](l+1)}</div>`;
if(!mx&&ok){const b=document.createElement('button');b.textContent=`${k=='C'?'✦':'💎'} ${f(cost)}`;b.disabled=cur<cost;b.onclick=()=>{S[k=='C'?'co':'sh']-=cost;S.lv[sel]=l+1;snd(600,.15);sv();rt()};$('#det').append(b)}
else if(!ok)$('#det').innerHTML+=`<span>🔒 Unlock ${br[i-1][2]} first</span>`}
document.querySelectorAll('#tabs button').forEach((b,i)=>b.onclick=()=>{tab=i;cf=0;sel=i?'cpow':'slow';rt()});
$('#play').onclick=play;
function rs(){dpr=devicePixelRatio||1;W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr}
onresize=rs;rs();rt();
</script></body></html>
